# Root .env.example - copy to .env and edit per environment

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logsdb
DB_USER=devlogs
DB_PASSWORD=devlogs

# Redis
REDIS_URL=redis://localhost:6379
REDIS_STREAM_KEY=logs-stream

# Auth service
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=24h

# Query service
PG_URL=postgres://devlogs:devlogs@localhost:5432/logsdb

# Collector / sample apps
COLLECTOR_URL=http://localhost:4000/logs
LOG_API_KEY=idl_sk_example_key
LOG_API_KEY2=idl_sk_example_key_2
